# ============================================================
# TaskMaster – Umgebungsvariablen (Vorlage)
# ============================================================
# Diese Datei als `.env` kopieren und die Werte anpassen, wenn du das
# Docker-Compose-File nutzt:
#   cp .env.example .env
#
# Unter CasaOS kannst du die Variablen stattdessen direkt in den
# App-Einstellungen des Containers setzen (gleiche Namen).
#
# WICHTIG: `.env` wird von Git ignoriert und nie eingecheckt.
# ============================================================

# ------------------------------------------------------------
# Sicherheit
# ------------------------------------------------------------

# Geheimnis zum Signieren der JWT-Tokens.
# MUSS in Produktion auf einen langen, zufälligen Wert gesetzt werden
# (mindestens 16 Zeichen). Sonst können Tokens gefälscht werden.
# Erzeugen:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Lebensdauer des Access-Tokens (ms-Format, z. B. "15m", "1h").
# Das Access-Token liegt im Browser-Speicher – kurz halten.
# JWT_ACCESS_TTL=15m

# Lebensdauer des Refresh-Tokens (z. B. "7d", "30d").
# Liegt als HttpOnly-Cookie und erneuert das Access-Token.
# JWT_REFRESH_TTL=7d

# ------------------------------------------------------------
# Initialer Admin-User
# ------------------------------------------------------------

# E-Mail und Passwort des Admin-Kontos. Werden NUR beim allerersten Start
# verwendet (wenn noch keine Nutzer existieren). Danach ignoriert.
ADMIN_EMAIL=admin@taskmaster.local
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# Server / Datenbank (meist unverändert lassen)
# ------------------------------------------------------------

# HTTP-Port innerhalb des Containers. Muss zur EXPOSE-Deklaration im
# Dockerfile passen. Das Port-Mapping nach außen erfolgt in docker-compose.yml.
# PORT=8080

# Pfad zur SQLite-Datei – innerhalb des Docker-Volumes, damit die Daten
# Neustarts überleben.
# DB_PATH=/app/data/taskmaster.db

# ------------------------------------------------------------
# Migration / Backup
# ------------------------------------------------------------

# Automatische Migration beim Start (ohne Admin-Bootstrap).
# "true"  – Migrationen werden beim Start automatisch angewendet (Entwicklung / CI).
# "false" – Bei Migrationsbedarf startet der Server im Maintenance-Modus;
#           ein Admin muss die Migration über die Bootstrap-UI auslösen.
# Nicht gesetzt: Entwicklung = true, Produktion = false.
# AUTO_MIGRATE=false

# Verzeichnis für automatische Backups vor der Migration.
# Default: <DB_PATH-Verzeichnis>/backups
# BACKUP_DIR=/app/data/backups

# Maximale Anzahl aufzubewahrender Backups (älteste werden gelöscht).
# BACKUP_KEEP=5

# ------------------------------------------------------------
# Nächtliche Transkription auf dem Server (optional)
# ------------------------------------------------------------

# Transkribiert der Server nachts selbst, was kein Gerät erledigt hat?
# "true"  – ja: lädt beim ersten Lauf einmalig ca. 670 MB Modell und rechnet
#           nachts auf der CPU (1,5–2 GB Speicher während des Laufs).
# "false" – nein (Default). Aufnahmen warten dann auf ein Gerät mit Modell.
# TRANSCRIBE_SERVER=false

# Uhrzeit des Laufs (HH:MM) und die Zeitzone, in der sie gilt.
# Achtung: Docker läuft standardmäßig in UTC – deshalb steht die Zeitzone hier
# fest und nicht in der Container-Zeitzone.
# TRANSCRIBE_AT=03:00
# TRANSCRIPTION_TZ=Europe/Berlin

# Zeitbudget eines Laufs und Rechenzeit-Obergrenze pro Aufnahme (Minuten).
# Reicht das Budget nicht, bleiben die restlichen Aufnahmen für die nächste Nacht.
# TRANSCRIBE_BUDGET_MINUTES=240
# TRANSCRIBE_JOB_MINUTES=120

# Ablage des Sprachmodells. Default: <DB_PATH-Verzeichnis>/models
# MODEL_DIR=/app/data/models

# Ablage der Audioaufnahmen. Default: <DB_PATH-Verzeichnis>/audio
# AUDIO_DIR=/app/data/audio
